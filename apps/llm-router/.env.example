# —— llm-router（统一模型路由网关）——
# 与 apps/agent-worker 的 .env.local 互斥：网关起来之后，agent-worker 那边的
# ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY 必须清空，否则 dev 模式下会绕过网关
# 直连供应商（00-必读.md §五·①）。

# 监听端口。Claude Code 侧配 ANTHROPIC_BASE_URL=http://<host>:8790
PORT=8790

DATABASE_URL=postgresql://rush:rush@localhost:5432/rush

# —— 私钥（二选一，FILE 优先）——
# 用 `pnpm llm:keygen` 生成一对；公钥进 apps/web，私钥**只**进这里。
LLM_ROUTER_PRIVATE_KEY_FILE=/etc/llm-router/private-key.pem
# LLM_ROUTER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 目录快照的轮询兜底间隔（LISTEN/NOTIFY 正常时用不上）
LLM_CATALOG_POLL_MS=5000

# 收到 SIGTERM 后，readyz 转 503 到真正关闭监听之间的等待时间（在途流的排空窗口）
DRAIN_TIMEOUT_MS=30000

# 令牌认证缓存 TTL（毫秒）。吊销的生效上界 = 这个值；设为 0 则每次查库。
LLM_ROUTER_TOKEN_TTL_MS=15000

LOG_LEVEL=info

# —— 计量（M5·T5.1）——
# 逐调用明细是否落 llm_calls。设 false 则完全不写（转发行为不变）。
LLM_ROUTER_METERING_ENABLED=true
# 攒够多少条落一次库；也是单次事务的行数上限
LLM_ROUTER_METERING_BATCH_SIZE=100
# 定时 flush 间隔（毫秒）
LLM_ROUTER_METERING_FLUSH_MS=1000
# 内存队列上限。满了丢最老的并计数——绝不因为计量把网关拖 OOM
LLM_ROUTER_METERING_MAX_QUEUE=10000

# —— 预算闸门（M5·T5.2）——
# 关掉只是不拦截，llm_budget_usage 的累加不受影响
LLM_ROUTER_BUDGET_ENABLED=true
# 累计值缓存 TTL（毫秒）。这就是软限额的超出上界；设 0 = 每次查库 = 硬限额
LLM_ROUTER_BUDGET_CACHE_MS=10000

# —— 限流闸门（M5·T5.3，与预算开关互相独立）——
# 需要 REDIS_URL（或 sentinel 三件套）。Redis 不可达时降级为放行并告警
LLM_ROUTER_RATE_LIMIT_ENABLED=false
# 令牌没有 max_requests_per_minute 时的默认配额
LLM_ROUTER_RATE_LIMIT_RPM=600
# REDIS_URL=redis://localhost:6379
