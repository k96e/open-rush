{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // rootDir 放在包根：`test/` 里的 PGlite 装置被 src/**/__tests__ import，
    // 与 packages/db 同款。tsup 只以 src/index.ts 为入口，产物不受影响。
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
