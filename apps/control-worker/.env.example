DATABASE_URL=postgresql://rush:rush@localhost:5432/rush

# OpenSandbox
OPENSANDBOX_API_URL=http://localhost:8090
OPENSANDBOX_EXEC_HOST=localhost

# —— llm-router 接入（M6）——
# 设了才走网关：控制面会为每个 run 签发短时令牌并注入沙箱 env。
# 留空 = 不装配，行为与接网关之前完全一致（灰度 / 回滚开关）。
# LLM_ROUTER_BASE_URL=http://localhost:8790
# agents.model 为空时的回落 alias（要能在 llm-router 目录里解析出来）
# LLM_ROUTER_DEFAULT_MODEL=sonnet
# 令牌有效期（秒）。缺省 3900 = 沙箱 ttl 3600 + 5 分钟缓冲
# LLM_ROUTER_TOKEN_TTL_SECONDS=3900
