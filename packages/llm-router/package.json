    "clean": "rm -rf dist node_modules coverage"
  },
  "dependencies": {
    "@open-rush/contracts": "workspace:*",
    "@open-rush/db": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@types/node": "^25.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.0"
  }
